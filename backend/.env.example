DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="replace_this_with_a_secure_random_string"
PORT=4000
OPENAI_API_KEY="your_openai_api_key_here"
# Set to 'true' to store passwords in plaintext (simpler for development/testing)
# Set to 'false' to use bcrypt hashing (more secure for production)
PLAINTEXT_PASSWORDS=true
